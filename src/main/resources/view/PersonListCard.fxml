<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" fx:id="cardPane" spacing="9" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="12" right="14" bottom="12" left="14" /></padding>
  <HBox alignment="BASELINE_LEFT" spacing="8">
    <Label fx:id="id" minWidth="38" prefWidth="38" maxWidth="38" styleClass="card-index" />
    <Label fx:id="name" minWidth="0" maxWidth="Infinity" textOverrun="ELLIPSIS"
           styleClass="card-name" HBox.hgrow="ALWAYS" />
    <HBox fx:id="tags" alignment="BASELINE_LEFT" spacing="6" />
  </HBox>
  <GridPane hgap="18" styleClass="summary-grid">
    <columnConstraints>
      <ColumnConstraints percentWidth="35" />
      <ColumnConstraints percentWidth="32" />
      <ColumnConstraints percentWidth="33" />
    </columnConstraints>
    <VBox minWidth="0" GridPane.columnIndex="0">
      <Label text="Subject" styleClass="summary-key" />
      <Label fx:id="subject" minWidth="0" maxWidth="Infinity" styleClass="summary-label" />
    </VBox>
    <VBox minWidth="0" GridPane.columnIndex="1">
      <Label text="Education level" styleClass="summary-key" />
      <Label fx:id="educationLevel" minWidth="0" maxWidth="Infinity" styleClass="summary-label" />
    </VBox>
    <VBox minWidth="0" GridPane.columnIndex="2">
      <Label text="Next lesson" styleClass="summary-key" />
      <Label fx:id="lesson" minWidth="0" maxWidth="Infinity" styleClass="summary-label" />
    </VBox>
  </GridPane>
</VBox>
