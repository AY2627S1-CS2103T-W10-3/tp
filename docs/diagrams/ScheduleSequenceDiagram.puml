@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":ScheduleCommandParser" as ScheduleCommandParser LOGIC_COLOR
participant "s:ScheduleCommand" as ScheduleCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "student:Person" as Student MODEL_COLOR
end box

[-> LogicManager : execute("schedule 1 at/2026-10-30 16:00")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("schedule 1 at/2026-10-30 16:00")
activate AddressBookParser

create ScheduleCommandParser
AddressBookParser -> ScheduleCommandParser
activate ScheduleCommandParser
ScheduleCommandParser --> AddressBookParser
deactivate ScheduleCommandParser

AddressBookParser -> ScheduleCommandParser : parse("1 at/2026-10-30 16:00")
activate ScheduleCommandParser

note right of ScheduleCommandParser
Validates the index and the
YYYY-MM-DD HH:mm format only
end note

create ScheduleCommand
ScheduleCommandParser -> ScheduleCommand : ScheduleCommand(1, lesson)
activate ScheduleCommand
ScheduleCommand --> ScheduleCommandParser
deactivate ScheduleCommand

ScheduleCommandParser --> AddressBookParser : s
deactivate ScheduleCommandParser
ScheduleCommandParser -[hidden]-> AddressBookParser
destroy ScheduleCommandParser

AddressBookParser --> LogicManager : s
deactivate AddressBookParser

LogicManager -> ScheduleCommand : execute(m)
activate ScheduleCommand

ScheduleCommand -> Model : getFilteredPersonList()
activate Model
Model --> ScheduleCommand : displayed students
deactivate Model

alt lesson is not after LocalDateTime.now(clock)
    ScheduleCommand -->> LogicManager : CommandException
else lesson is in the future
    ScheduleCommand -> Student : withLesson(Optional.of(lesson))
    activate Student
    Student --> ScheduleCommand : scheduled
    deactivate Student

    ScheduleCommand -> Model : setPerson(student, scheduled)
    activate Model
    Model --> ScheduleCommand
    deactivate Model

    ScheduleCommand --> LogicManager : CommandResult

    LogicManager -> LogicManager : save address book
    note right of LogicManager
    Restores the previous address book
    if saving fails
    end note
end
deactivate ScheduleCommand

[<--LogicManager
deactivate LogicManager
@enduml
