@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FilterCommandParser" as FilterCommandParser LOGIC_COLOR
participant "f:FilterCommand" as FilterCommand LOGIC_COLOR
participant "e:EditCommand" as EditCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:PersonMatchesFiltersPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
participant "result:FilteredList<Person>" as ResultView MODEL_COLOR
end box

[-> LogicManager : execute("filter s/Mathematics")
activate LogicManager
LogicManager -> AddressBookParser : parseCommand("filter s/Mathematics")
activate AddressBookParser

create FilterCommandParser
AddressBookParser -> FilterCommandParser
activate FilterCommandParser

FilterCommandParser --> AddressBookParser
deactivate FilterCommandParser

AddressBookParser -> FilterCommandParser : parse("s/Mathematics")
activate FilterCommandParser

create Predicate
FilterCommandParser -> Predicate
activate Predicate
Predicate --> FilterCommandParser
deactivate Predicate

create FilterCommand
FilterCommandParser -> FilterCommand
activate FilterCommand
FilterCommand --> FilterCommandParser
deactivate FilterCommand

FilterCommandParser --> AddressBookParser : f
deactivate FilterCommandParser

'Hidden arrow positions the destroy marker below the activation bar.
FilterCommandParser -[hidden]-> AddressBookParser
destroy FilterCommandParser

AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> FilterCommand : execute(m)
activate FilterCommand
FilterCommand -> Model : updateFilteredPersonList(p)
activate Model
Model -> ResultView : setPredicate(p)
activate ResultView

loop for each student
    ResultView -> Predicate : test(student)
    activate Predicate
    Predicate --> ResultView : matches
    deactivate Predicate
end

ResultView --> Model
deactivate ResultView
Model --> FilterCommand
deactivate Model

FilterCommand --> LogicManager : CommandResult
deactivate FilterCommand

[<-- LogicManager : matching students with displayed indices
deactivate LogicManager

[-> LogicManager : execute("edit 1 p/91234567")
activate LogicManager
note over LogicManager, EditCommand
Parsing of edit is omitted.
end note
LogicManager -> EditCommand : execute(m)
activate EditCommand
EditCommand -> Model : getFilteredPersonList()
activate Model
Model --> EditCommand : result
deactivate Model

EditCommand -> ResultView : get(0)
activate ResultView
ResultView --> EditCommand : displayed student 1
deactivate ResultView

EditCommand -> Model : setPerson(displayed student 1, edited)
activate Model
Model --> EditCommand
deactivate Model

EditCommand -> Model : updateFilteredPersonList(show all)
activate Model
Model -> ResultView : setPredicate(show all)
activate ResultView
ResultView --> Model
deactivate ResultView
Model --> EditCommand
deactivate Model

EditCommand --> LogicManager : CommandResult
deactivate EditCommand

[<-- LogicManager : edit confirmation
deactivate LogicManager
@enduml
