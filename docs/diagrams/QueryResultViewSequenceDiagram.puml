@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant "f:FilterCommand" as FilterCommand LOGIC_COLOR
participant "e:EditCommand" as EditCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant "result:FilteredList<Person>" as ResultView MODEL_COLOR
participant "p:PersonMatchesFiltersPredicate" as Predicate MODEL_COLOR
end box

[-> FilterCommand : execute(m)
activate FilterCommand

FilterCommand -> ModelManager : updateFilteredPersonList(p)
activate ModelManager
ModelManager -> ResultView : setPredicate(p)
activate ResultView

loop for each student
    ResultView -> Predicate : test(student)
    activate Predicate
    Predicate --> ResultView : matches
    deactivate Predicate
end

ResultView --> ModelManager
deactivate ResultView
ModelManager --> FilterCommand
deactivate ModelManager
FilterCommand -->] : CommandResult
deactivate FilterCommand

note across
The UI observes result and displays consecutive one-based indices.
end note

[-> EditCommand : execute(m)
activate EditCommand
EditCommand -> ModelManager : getFilteredPersonList()
activate ModelManager
ModelManager --> EditCommand : result
deactivate ModelManager

EditCommand -> ResultView : get(0)
activate ResultView
ResultView --> EditCommand : displayed student 1
deactivate ResultView

EditCommand -> ModelManager : setPerson(displayed student 1, edited)
activate ModelManager
ModelManager --> EditCommand
deactivate ModelManager

EditCommand -> ModelManager : updateFilteredPersonList(show all)
activate ModelManager
ModelManager -> ResultView : setPredicate(show all)
activate ResultView
ResultView --> ModelManager
deactivate ResultView
ModelManager --> EditCommand
deactivate ModelManager

EditCommand -->] : CommandResult
deactivate EditCommand
@enduml
